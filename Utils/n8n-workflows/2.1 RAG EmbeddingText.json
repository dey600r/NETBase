    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.text;\n\n// Separar por puntos, limpiar espacios y eliminar frases vacías\nconst frases = texto\n  .split(\".\")\n  .map(frase => frase.trim())\n  .filter(frase => frase.length > 0);\n\n// Crear un elemento independiente por cada frase\nreturn frases.map((frase, index) => ({\n  json: {\n    id: index + 1,\n    texto: frase\n  }\n}));"
      },
